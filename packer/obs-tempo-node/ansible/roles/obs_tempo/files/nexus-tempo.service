[Unit]
Description=Grafana Tempo (NexusPlatform; obs-tempo-node simple-scalable, Phase 0.I.3)
Documentation=https://grafana.com/docs/tempo/latest/
After=network-online.target observability-node-firstboot.service
Wants=network-online.target
Requires=observability-node-firstboot.service

[Service]
Type=simple
User=tempo
Group=tempo
WorkingDirectory=/var/lib/nexus-tempo
# T15 transient: default `single-binary` mode is single-node-only (no memberlist
# ring). `-target=scalable-single-binary` enables the memberlist-coordinated
# multi-node mode (handbook §3.C).
ExecStart=/opt/tempo/tempo -config.file=/etc/nexus-tempo/tempo.yaml -target=scalable-single-binary
ExecReload=/bin/kill -HUP $MAINPID
RuntimeDirectory=nexus-tempo
RuntimeDirectoryMode=0750
Restart=on-failure
RestartSec=10s
TimeoutStopSec=30s
LimitNOFILE=65536
NoNewPrivileges=true
PrivateTmp=true
ProtectHome=true
ProtectSystem=full
ProtectKernelTunables=true
ProtectKernelModules=true
ProtectControlGroups=true
RestrictSUIDSGID=true
LockPersonality=true
MemoryDenyWriteExecute=false

[Install]
WantedBy=multi-user.target
