[Unit]
Description=Grafana Tempo (NexusPlatform; obs-tempo-node simple-scalable, Phase 0.I.3)
Documentation=https://grafana.com/docs/tempo/latest/
After=network-online.target observability-node-firstboot.service
Wants=network-online.target
Requires=observability-node-firstboot.service

[Service]
Type=simple
User=tempo
Group=tempo
WorkingDirectory=/var/lib/nexus-tempo
ExecStart=/opt/tempo/tempo -config.file=/etc/nexus-tempo/tempo.yaml
ExecReload=/bin/kill -HUP $MAINPID
RuntimeDirectory=nexus-tempo
RuntimeDirectoryMode=0750
Restart=on-failure
RestartSec=10s
TimeoutStopSec=30s
LimitNOFILE=65536
NoNewPrivileges=true
PrivateTmp=true
ProtectHome=true
ProtectSystem=full
ProtectKernelTunables=true
ProtectKernelModules=true
ProtectControlGroups=true
RestrictSUIDSGID=true
LockPersonality=true
MemoryDenyWriteExecute=false

[Install]
WantedBy=multi-user.target
